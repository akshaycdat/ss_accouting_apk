{
  "name": "suyash-accounting-mobile",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/SuyashAccountingMobile/main.jsbundle --assets-dest ios/SuyashAccountingMobile",
    "build:ios": "npm run bundle:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.6.8",
    "expo": "^51.0.39",
    "expo-modules-core": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-vector-icons": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/runtime": "^7.24.4",
    "@react-native-community/cli": "^13.6.6",
    "@react-native-community/cli-platform-android": "^13.6.6",
    "@react-native-community/cli-platform-ios": "^13.6.6",
    "@react-native/babel-preset": "^0.74.83",
    "@react-native/eslint-config": "^0.74.83",
    "@react-native/metro-config": "^0.74.83",
    "@react-native/typescript-config": "^0.74.83",
    "@types/react": "^18.2.79",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
